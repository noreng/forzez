{
  "name": "forzez",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @forzez/web dev",
    "build": "pnpm --filter @forzez/web build",
    "lint": "pnpm -r lint && pnpm check:design",
    "check:design": "node scripts/check-design.mjs",
    "check:truss-art": "node scripts/check-truss-art.mjs",
    "check:studio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-studio.mjs"
  }
}
